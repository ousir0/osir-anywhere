{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.osirclaw.com/osir-client-handoff/v1/schema.json",
  "title": "OSIR Client first-party handoff v1 (contract only; not deployed)",
  "$ref": "#/$defs/authorizeRequest",
  "$defs": {
    "opaqueId": {
      "type": "string",
      "minLength": 32,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_-]+$(?![\\s\\S])",
      "description": "Opaque flow/receiver ID; exact Client native DTO alphabet and 32..128 boundary."
    },
    "canonical32": {
      "type": "string",
      "minLength": 43,
      "maxLength": 43,
      "pattern": "^[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]$(?![\\s\\S])",
      "description": "Unpadded canonical base64url of exactly 32 bytes; runtime generators use CSPRNG."
    },
    "verifier": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9_-]{64}$(?![\\s\\S])",
      "description": "Unpadded base64url of exactly 48 random bytes, held only in Anywhere Main."
    },
    "actions": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "uniqueItems": true,
      "prefixItems": [
        {
          "type": "string",
          "const": "identity",
          "minLength": 8,
          "maxLength": 8
        },
        {
          "type": "string",
          "const": "connect-local",
          "minLength": 13,
          "maxLength": 13
        },
        {
          "type": "string",
          "const": "bootstrap-configured-tools",
          "minLength": 26,
          "maxLength": 26
        }
      ],
      "items": false
    },
    "recipient": {
      "type": "string",
      "const": "osir-anywhere-desktop",
      "minLength": 21,
      "maxLength": 21
    },
    "origin": {
      "type": "string",
      "const": "https://anywhere.osirclaw.com",
      "minLength": 29,
      "maxLength": 29
    },
    "audience": {
      "type": "string",
      "const": "osir-anywhere-server",
      "minLength": 20,
      "maxLength": 20
    },
    "kid": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9_-]+$(?![\\s\\S])"
    },
    "subject": {
      "type": "string",
      "minLength": 1,
      "maxLength": 19,
      "pattern": "^[1-9][0-9]{0,18}$(?![\\s\\S])",
      "description": "Runtime must also enforce <= 9223372036854775807, without floating-point conversion."
    },
    "unixSeconds": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "compactAssertion": {
      "type": "string",
      "minLength": 100,
      "maxLength": 4096,
      "pattern": "^[A-Za-z0-9_-]{1,512}\\.[A-Za-z0-9_-]{1,3072}\\.[A-Za-z0-9_-]{85}[AQgw]$(?![\\s\\S])",
      "description": "Ed25519 compact JWS shape only. Runtime must decode bounded JSON, verify signature and authenticated typ/claims."
    },
    "nativeLaunch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "flowId"
      ],
      "properties": {
        "flowId": {
          "$ref": "#/$defs/opaqueId"
        }
      }
    },
    "nativeHandshake": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "flowId",
        "receiverInstanceId",
        "state",
        "codeChallenge",
        "codeChallengeMethod",
        "recipientClientId",
        "targetOrigin",
        "actions"
      ],
      "properties": {
        "version": {
          "type": "integer",
          "const": 1
        },
        "flowId": {
          "$ref": "#/$defs/opaqueId"
        },
        "receiverInstanceId": {
          "$ref": "#/$defs/opaqueId"
        },
        "state": {
          "$ref": "#/$defs/canonical32"
        },
        "codeChallenge": {
          "$ref": "#/$defs/canonical32"
        },
        "codeChallengeMethod": {
          "type": "string",
          "const": "S256",
          "minLength": 4,
          "maxLength": 4
        },
        "recipientClientId": {
          "$ref": "#/$defs/recipient"
        },
        "targetOrigin": {
          "$ref": "#/$defs/origin"
        },
        "actions": {
          "$ref": "#/$defs/actions"
        }
      }
    },
    "authorizeRequest": {
      "$ref": "#/$defs/nativeHandshake"
    },
    "nativeCodeDelivery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "flowId",
        "state",
        "code",
        "expiresIn",
        "configuredToolTypes"
      ],
      "properties": {
        "flowId": {
          "$ref": "#/$defs/opaqueId"
        },
        "state": {
          "$ref": "#/$defs/canonical32"
        },
        "code": {
          "$ref": "#/$defs/canonical32"
        },
        "expiresIn": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60
        },
        "configuredToolTypes": {
          "description": "Secret-free native verified connection snapshot only; canonical ordered unique subset. Never send to HTTP/JWT/cloud config.",
          "type": "array",
          "minItems": 0,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "claude",
              "codex",
              "dsh"
            ],
            "minLength": 3,
            "maxLength": 6
          },
          "enum": [
            [],
            [
              "claude"
            ],
            [
              "codex"
            ],
            [
              "dsh"
            ],
            [
              "claude",
              "codex"
            ],
            [
              "claude",
              "dsh"
            ],
            [
              "codex",
              "dsh"
            ],
            [
              "claude",
              "codex",
              "dsh"
            ]
          ]
        }
      }
    },
    "capabilitiesResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message",
        "data"
      ],
      "properties": {
        "code": {
          "type": "integer",
          "const": 0
        },
        "message": {
          "type": "string",
          "const": "success",
          "minLength": 7,
          "maxLength": 7
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "protocolVersion",
            "recipientClientId",
            "targetOrigin",
            "codeExpiresIn",
            "requiredScope",
            "allowedActions"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "protocolVersion": {
              "type": "integer",
              "const": 1
            },
            "recipientClientId": {
              "$ref": "#/$defs/recipient"
            },
            "targetOrigin": {
              "$ref": "#/$defs/origin"
            },
            "codeExpiresIn": {
              "type": "integer",
              "const": 60
            },
            "requiredScope": {
              "type": "string",
              "const": "account:read",
              "minLength": 12,
              "maxLength": 12
            },
            "allowedActions": {
              "$ref": "#/$defs/actions"
            }
          }
        }
      }
    },
    "authorizeResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message",
        "data"
      ],
      "properties": {
        "code": {
          "type": "integer",
          "const": 0
        },
        "message": {
          "type": "string",
          "const": "success",
          "minLength": 7,
          "maxLength": 7
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "expires_in",
            "recipient_client_id",
            "audience"
          ],
          "properties": {
            "code": {
              "$ref": "#/$defs/canonical32"
            },
            "expires_in": {
              "type": "integer",
              "const": 60
            },
            "recipient_client_id": {
              "$ref": "#/$defs/recipient"
            },
            "audience": {
              "$ref": "#/$defs/audience"
            }
          }
        }
      }
    },
    "tokenRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "grant_type",
        "client_id",
        "code",
        "code_verifier",
        "state",
        "receiver_instance_id",
        "target_origin"
      ],
      "properties": {
        "grant_type": {
          "type": "string",
          "const": "urn:osir:params:grant-type:anywhere-handoff",
          "minLength": 43,
          "maxLength": 43
        },
        "client_id": {
          "$ref": "#/$defs/recipient"
        },
        "code": {
          "$ref": "#/$defs/canonical32"
        },
        "code_verifier": {
          "$ref": "#/$defs/verifier"
        },
        "state": {
          "$ref": "#/$defs/canonical32"
        },
        "receiver_instance_id": {
          "$ref": "#/$defs/opaqueId"
        },
        "target_origin": {
          "$ref": "#/$defs/origin"
        }
      }
    },
    "tokenResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message",
        "data"
      ],
      "properties": {
        "code": {
          "type": "integer",
          "const": 0
        },
        "message": {
          "type": "string",
          "const": "success",
          "minLength": 7,
          "maxLength": 7
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "assertion",
            "token_type",
            "expires_in",
            "audience"
          ],
          "properties": {
            "assertion": {
              "$ref": "#/$defs/compactAssertion"
            },
            "token_type": {
              "type": "string",
              "const": "urn:osir:params:token-type:anywhere-handoff",
              "minLength": 43,
              "maxLength": 43
            },
            "expires_in": {
              "type": "integer",
              "const": 60
            },
            "audience": {
              "$ref": "#/$defs/audience"
            }
          }
        }
      }
    },
    "assertionHeader": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "alg",
        "typ",
        "kid"
      ],
      "properties": {
        "alg": {
          "type": "string",
          "const": "EdDSA",
          "minLength": 5,
          "maxLength": 5
        },
        "typ": {
          "type": "string",
          "const": "osir-anywhere-handoff+jwt",
          "minLength": 25,
          "maxLength": 25
        },
        "kid": {
          "$ref": "#/$defs/kid"
        }
      }
    },
    "assertionClaims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "iss",
        "aud",
        "sub",
        "client_id",
        "jti",
        "iat",
        "exp",
        "flow_id",
        "receiver_instance_id",
        "state_hash",
        "target_origin",
        "code_challenge",
        "code_challenge_method",
        "actions"
      ],
      "properties": {
        "iss": {
          "type": "string",
          "const": "https://osirclaw.com",
          "minLength": 20,
          "maxLength": 20
        },
        "aud": {
          "$ref": "#/$defs/audience"
        },
        "sub": {
          "$ref": "#/$defs/subject"
        },
        "client_id": {
          "$ref": "#/$defs/recipient"
        },
        "jti": {
          "$ref": "#/$defs/canonical32"
        },
        "iat": {
          "$ref": "#/$defs/unixSeconds"
        },
        "exp": {
          "$ref": "#/$defs/unixSeconds"
        },
        "flow_id": {
          "$ref": "#/$defs/opaqueId"
        },
        "receiver_instance_id": {
          "$ref": "#/$defs/opaqueId"
        },
        "state_hash": {
          "$ref": "#/$defs/canonical32"
        },
        "target_origin": {
          "$ref": "#/$defs/origin"
        },
        "code_challenge": {
          "$ref": "#/$defs/canonical32"
        },
        "code_challenge_method": {
          "type": "string",
          "const": "S256",
          "minLength": 4,
          "maxLength": 4
        },
        "actions": {
          "$ref": "#/$defs/actions"
        }
      },
      "description": "Authenticated handoff payload only. Additional runtime constraints: exp=iat+60, iat<=now<exp, sub fits signed int64, receiver/flow/state/S256/actions match the request, consume issuer+jti once."
    },
    "browserAssertionHeader": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "alg",
        "typ",
        "kid"
      ],
      "properties": {
        "alg": {
          "type": "string",
          "const": "EdDSA",
          "minLength": 5,
          "maxLength": 5
        },
        "typ": {
          "type": "string",
          "const": "osir-anywhere-login+jwt",
          "minLength": 23,
          "maxLength": 23
        },
        "kid": {
          "$ref": "#/$defs/kid"
        }
      }
    },
    "browserAssertionClaims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "iss",
        "aud",
        "sub",
        "client_id",
        "jti",
        "iat",
        "exp"
      ],
      "properties": {
        "iss": {
          "type": "string",
          "const": "https://osirclaw.com",
          "minLength": 20,
          "maxLength": 20
        },
        "aud": {
          "$ref": "#/$defs/audience"
        },
        "sub": {
          "$ref": "#/$defs/subject"
        },
        "client_id": {
          "$ref": "#/$defs/recipient"
        },
        "jti": {
          "$ref": "#/$defs/canonical32"
        },
        "iat": {
          "$ref": "#/$defs/unixSeconds"
        },
        "exp": {
          "$ref": "#/$defs/unixSeconds"
        }
      }
    },
    "handoffProof": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "flowId",
        "state",
        "receiverInstanceId",
        "codeVerifier",
        "targetOrigin"
      ],
      "properties": {
        "flowId": {
          "$ref": "#/$defs/opaqueId"
        },
        "state": {
          "$ref": "#/$defs/canonical32"
        },
        "receiverInstanceId": {
          "$ref": "#/$defs/opaqueId"
        },
        "codeVerifier": {
          "$ref": "#/$defs/verifier"
        },
        "targetOrigin": {
          "$ref": "#/$defs/origin"
        }
      }
    },
    "desktopExchangeRequest": {
      "description": "Mutually exclusive wire branches. Authenticated JWS typ is the discriminator; shape alone cannot authenticate it.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "assertion"
          ],
          "properties": {
            "assertion": {
              "$ref": "#/$defs/compactAssertion"
            }
          },
          "title": "BrowserDesktopLogin",
          "description": "Requires verified osir-anywhere-login+jwt, desktop client; rejects handoff typ."
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "assertion",
            "handoff"
          ],
          "properties": {
            "assertion": {
              "$ref": "#/$defs/compactAssertion"
            },
            "handoff": {
              "$ref": "#/$defs/handoffProof"
            }
          },
          "title": "ClientHandoff",
          "description": "Requires verified osir-anywhere-handoff+jwt plus all bound handoff fields."
        }
      ]
    },
    "errorResponse": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "message",
            "reason"
          ],
          "properties": {
            "code": {
              "type": "integer",
              "const": 400
            },
            "message": {
              "type": "string",
              "const": "Invalid handoff request",
              "minLength": 23,
              "maxLength": 23
            },
            "reason": {
              "type": "string",
              "const": "invalid_request",
              "minLength": 15,
              "maxLength": 15
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "message",
            "reason"
          ],
          "properties": {
            "code": {
              "type": "integer",
              "const": 401
            },
            "message": {
              "type": "string",
              "const": "Invalid source session",
              "minLength": 22,
              "maxLength": 22
            },
            "reason": {
              "type": "string",
              "const": "invalid_source_session",
              "minLength": 22,
              "maxLength": 22
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "message",
            "reason"
          ],
          "properties": {
            "code": {
              "type": "integer",
              "const": 401
            },
            "message": {
              "type": "string",
              "const": "Invalid handoff",
              "minLength": 15,
              "maxLength": 15
            },
            "reason": {
              "type": "string",
              "const": "invalid_handoff",
              "minLength": 15,
              "maxLength": 15
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "message",
            "reason"
          ],
          "properties": {
            "code": {
              "type": "integer",
              "const": 403
            },
            "message": {
              "type": "string",
              "const": "Handoff unavailable",
              "minLength": 19,
              "maxLength": 19
            },
            "reason": {
              "type": "string",
              "const": "capability_unavailable",
              "minLength": 22,
              "maxLength": 22
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "message",
            "reason"
          ],
          "properties": {
            "code": {
              "type": "integer",
              "const": 403
            },
            "message": {
              "type": "string",
              "const": "Receiver not verified",
              "minLength": 21,
              "maxLength": 21
            },
            "reason": {
              "type": "string",
              "const": "receiver_untrusted",
              "minLength": 18,
              "maxLength": 18
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "message",
            "reason"
          ],
          "properties": {
            "code": {
              "type": "integer",
              "const": 403
            },
            "message": {
              "type": "string",
              "const": "Explicit Client action required",
              "minLength": 31,
              "maxLength": 31
            },
            "reason": {
              "type": "string",
              "const": "consent_required",
              "minLength": 16,
              "maxLength": 16
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "message",
            "reason"
          ],
          "properties": {
            "code": {
              "type": "integer",
              "const": 409
            },
            "message": {
              "type": "string",
              "const": "Account mismatch",
              "minLength": 16,
              "maxLength": 16
            },
            "reason": {
              "type": "string",
              "const": "account_mismatch",
              "minLength": 16,
              "maxLength": 16
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "message",
            "reason"
          ],
          "properties": {
            "code": {
              "type": "integer",
              "const": 429
            },
            "message": {
              "type": "string",
              "const": "Handoff rate limit exceeded",
              "minLength": 27,
              "maxLength": 27
            },
            "reason": {
              "type": "string",
              "const": "rate_limited",
              "minLength": 12,
              "maxLength": 12
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "message",
            "reason"
          ],
          "properties": {
            "code": {
              "type": "integer",
              "const": 503
            },
            "message": {
              "type": "string",
              "const": "Handoff dependency unavailable",
              "minLength": 30,
              "maxLength": 30
            },
            "reason": {
              "type": "string",
              "const": "dependency_unavailable",
              "minLength": 22,
              "maxLength": 22
            }
          }
        }
      ]
    }
  }
}
